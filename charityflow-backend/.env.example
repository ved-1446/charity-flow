# MongoDB connection string (local or MongoDB Atlas M0 cluster)
MONGO_URI=mongodb://localhost:27017/charityflow

# JSON Web Token secret key (replace with strong random secret in production)
JWT_SECRET=dummy_jwt_secret_key_change_in_production_32chars_min

# Token expiration in hours
JWT_EXPIRE_HOURS=8

# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@charityflow.org

# Demo mode flag (true enables simulated background delivery and reset-test-data endpoint)
DEMO_MODE=true

# Delay in seconds between simulated delivery steps
DEMO_DELIVERY_DELAY_SECONDS=90

# Allowed CORS origins (comma-separated for production, or * for local dev)
# Production example: CORS_ORIGINS=https://charityflow.onrender.com
CORS_ORIGINS=*

# HTTP server listening port
PORT=8000

# Proxy Trust: set to true when deployed behind reverse proxies like Render or Nginx
TRUST_PROXY=false

# Optional Cloudinary Storage: set to store donation photos in Cloudinary (leave empty for local disk /uploads)
# Example: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Optional seed password overrides for demo accounts
SEED_ADMIN_PASSWORD=Admin@1234
SEED_DONOR_PASSWORD=Donor@1234
